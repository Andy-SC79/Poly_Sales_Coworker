# ==============================================================================
# Poly AI Coworker — Environment Configuration Template
# Rename this file to .env and fill in your real keys.
# ==============================================================================

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM Providers ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3:8b

# --- LangSmith / Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=poly-ai-coworker

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=909774282
ADMIN_PHONE=whatsapp:+1234567890

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Droppi ---
DROPPI_API_KEY=
DROPPI_BASE_URL=https://api.dropi.co

# --- Supabase ---
SUPABASE_ORDERS_URL=https://drqxuknpzzvssuvcqhqp.supabase.co
