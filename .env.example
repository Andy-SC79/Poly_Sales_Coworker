# ==============================================================================
# Poly AI Coworker — Environment Configuration Template
# ==============================================================================
# Rename this file to .env and fill in your real keys.
# ==============================================================================

# --- APP SETTINGS ---
APP_ENV=development
LOG_LEVEL=info

# --- LLM SETTINGS ---
# Use 'ollama' for local inference or 'openai' for cloud
MODEL_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=your_openai_api_key_here

# --- DATABASE (PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://poly:poly_pass@localhost:5432/poly_db

# --- VECTOR STORE (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=product_catalog

# --- CACHE & WORKERS (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- CHANNELS: WHATSAPP (Twilio) ---
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# --- CHANNELS: TELEGRAM (Admin Hub) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here
