# Poly AI Coworker — Git Ignore

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
*.env.local

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual Environments ────────────────────────────────────────────────────
venv/
.venv/
env/

# ─── Poetry ──────────────────────────────────────────────────────────────────
# Keep poetry.lock committed; ignore only local cache
.cache/

# ─── Testing ─────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Docker ──────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it's part of the project
# Ignore local override files
docker-compose.override.yml

# ─── Database Files ──────────────────────────────────────────────────────────
*.sqlite3
*.db

# ─── Audio / Media Uploads ───────────────────────────────────────────────────
media/
uploads/

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
